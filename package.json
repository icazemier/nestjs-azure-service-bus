{
  "name": "@icazemier/nestjs-azure-service-bus",
  "private": false,
  "version": "0.0.23-beta.0",
  "type": "module",
  "description": "Maintained NestJS module and decorators for Azure Service Bus: inject senders, receivers and the administration client straight into your providers.",
  "keywords": [
    "nestjs",
    "nest",
    "azure",
    "azure-service-bus",
    "service-bus",
    "servicebus",
    "queue",
    "topic",
    "messaging",
    "amqp",
    "decorator",
    "typescript"
  ],
  "homepage": "https://github.com/icazemier/nestjs-azure-service-bus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icazemier/nestjs-azure-service-bus.git"
  },
  "bugs": {
    "url": "https://github.com/icazemier/nestjs-azure-service-bus/issues"
  },
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "types": "./build/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    }
  },
  "sideEffects": false,
  "author": "engcfraposo",
  "contributors": [
    {
      "name": "I. Cazemier",
      "email": "git@warmemelk.nl",
      "url": "https://github.com/icazemier"
    }
  ],
  "files": [
    "build/"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "build:esm": "tsc -p tsconfig-build-esm.json",
    "build:cjs": "tsc -p tsconfig-build-cjs.json",
    "fixup": "node ./scripts/fixup.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run fixup",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:cov": "jest --coverage",
    "smoke": "node ./scripts/smoke.mjs",
    "verify:published": "node ./scripts/verify-published.mjs",
    "changeset": "changeset",
    "pre-mode": "node ./scripts/pre-mode.mjs",
    "release:version": "npm run pre-mode && changeset version && npm install --package-lock-only",
    "release": "npm run pre-mode && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@azure/identity": "^4.0.0",
    "@azure/service-bus": "^7.9.0",
    "@nestjs/common": "^11.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/service-bus": "^7.9.5",
    "@changesets/cli": "2.31.1",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "node10",
            "ignoreDeprecations": "6.0",
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true,
            "esModuleInterop": true,
            "target": "ES2023",
            "strict": true
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "../coverage"
  }
}
