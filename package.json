{
  "name": "@icazemier/nestjs-azure-service-bus",
  "private": false,
  "version": "0.0.23-beta.0",
  "homepage": "https://github.com/icazemier/nestjs-azure-service-bus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icazemier/nestjs-azure-service-bus.git"
  },
  "bugs": {
    "url": "https://github.com/icazemier/nestjs-azure-service-bus/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "A dynamic module for NestJS that provides integration with Azure Service Bus.",
  "author": "engcfraposo",
  "contributors": [
    {
      "name": "I. Cazemier",
      "email": "git@warmemelk.nl",
      "url": "https://github.com/icazemier"
    }
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "smoke": "node ./scripts/smoke.mjs",
    "verify:published": "node ./scripts/verify-published.mjs",
    "changeset": "changeset",
    "pre-mode": "node ./scripts/pre-mode.mjs",
    "release:version": "npm run pre-mode && changeset version && npm install --package-lock-only",
    "release": "npm run pre-mode && changeset publish"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/service-bus": "^7.9.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.14",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.8",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
