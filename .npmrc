# Dependency lifecycle scripts are the delivery mechanism for the current
# generation of npm worms: a compromised release adds a `preinstall` hook that
# runs before any of your code does, harvests npm/GitHub/cloud credentials, and
# republishes itself through the tokens it finds.
#
# Nothing in this dependency tree needs an install script. The only two that
# declare one are @nestjs/core, whose postinstall just prints a support banner,
# and fsevents, an optional macOS file watcher used by `jest --watch`.
#
# CI already passes --ignore-scripts on every install; this makes it the default
# everywhere, so a local `npm install` cannot be the way in.
ignore-scripts=true
